# 복사해서 .env로 사용. 실제 키는 절대 커밋하지 않는다.

# --- DB ---
POSTGRES_DB=gagenavi
POSTGRES_USER=gagenavi
POSTGRES_PASSWORD=change-me

# --- API ---
DATABASE_URL=postgresql+asyncpg://gagenavi:change-me@localhost:55432/gagenavi   # 로컬 실행용 (compose에서는 db 호스트로 덮어씀)
APP_ENV=local                      # local | ci | prod
TZ=Asia/Seoul
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 관리자 계정은 환경 변수로 만들지 않는다: python -m jobs.set_admin_password <사용자명> (docs/30 §3)
STORAGE_DIR=./storage              # 공고 첨부 원문 (compose에서는 /app/storage)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me       # API와 웹이 같은 값 사용 (T-023, T-030)

# --- 테스트 ---
W0_SEOUL_CSV=                      # W0 재현 테스트용 UTF-8 CSV 경로 (없으면 skip)

# --- 외부 API (발급 후 입력) ---
JUSO_CONFM_KEY=                    # 도로명주소 검색 API (T-021)
KAKAO_REST_API_KEY=                # 좌표→주소 (T-032)
DATA_GO_KR_SERVICE_KEY=            # 공공데이터포털 인허가·기업마당 API (T-010, T-050)
ANTHROPIC_API_KEY=                 # 규칙 추출 전용 (T-052)

# --- 관측 ---
SENTRY_DSN=

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # 브라우저용
API_INTERNAL_URL=http://localhost:8000          # 서버 컴포넌트용 (compose에서는 http://api:8000)
NEXT_PUBLIC_KAKAO_JS_KEY=
INDEXING_ENABLED=false             # Gate 1 전에는 false (docs/40 §9)
SITE_URL=                          # 사이트 절대 주소(사이트맵·robots). 비우면 색인·사이트맵 꺼짐. 운영 도메인은 T-081
# REVALIDATE_SECRET도 apps/web/.env.local에 같은 값으로
